# Public contact address shown as the header "聯絡開發者" button. Leave empty to hide it.
VITE_CONTACT_EMAIL=
# Self-hosted sponsor slots (optional). JSON array. Unset = the built-in Whospost fundraising card; set to [] for no sponsor cards at all (forks).
# Slots: result_bottom (below the result overview and share card, above the check cards) and waiting (the in-progress screen). Put images in frontend/public/sponsor/.
# Image card: {"slot","campaign","image","href","alt"}; text card in the search-bar format: {"slot","campaign","text","cta","href"}.
# VITE_SPONSOR_SLOTS=[{"slot":"result_bottom","campaign":"acme-2026q4","image":"/sponsor/acme.png","href":"https://example.com/","alt":"Acme 贊助本月 500 次查詢"}]
VITE_SPONSOR_SLOTS=
# Election countdown in the header (optional). Target = polls open, ISO date-time with zone; set VITE_VOTE_COUNTDOWN=0 to hide the countdown and the 我會去投票 button.
# VITE_VOTE_OPEN_AT=2026-11-28T08:00:00+08:00
VITE_VOTE_OPEN_AT=
VITE_VOTE_COUNTDOWN=
