{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whospost",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "WhospostStore" },
      { "name": "SCAN_JOB", "class_name": "ScanJob" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WhospostStore", "ScanJob"] }],
  // New-scan requests per IP: 5 per minute. The daily per-IP quota is enforced in the data object.
  "ratelimits": [{ "name": "SCAN_RATE_LIMITER", "namespace_id": "2701", "simple": { "limit": 5, "period": 60 } }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "WHOSPOST_SCANS_ENABLED": "1",
    "WHOSPOST_APIFY_LIMIT_USD": "2",
    "WHOSPOST_DAILY_LIMIT_USD": "1",
    "WHOSPOST_IP_DAILY_SCANS": "3",
    "WHOSPOST_AI_ENABLED": "1",
    "WHOSPOST_AI_LIMIT_USD": "1",
    "WHOSPOST_CROSS_ACCOUNT_SEARCH": "0"
    // Per-deployment Turnstile settings are secrets, not vars, so each fork sets its own and deploys never reset them:
    // TURNSTILE_SITE_KEY, TURNSTILE_SECRET and TURNSTILE_HOSTNAMES (frontend hostnames, e.g. whospost.<account>.workers.dev;
    // never localhost). Without them new scans stay closed. Local values go in .dev.vars.
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
