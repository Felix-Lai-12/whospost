{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whospost",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/"]
  },
  // Browser Rendering: the browser fetch provider opens public Threads pages from Cloudflare's network. Plain
  // `wrangler dev` drives a local Chrome; `wrangler dev --remote` uses the real service. Used by the ScanJob object.
  "browser": { "binding": "BROWSER" },
  // Parsing one profile page is well under a second of CPU; the ceiling only guards a parser gone wrong while
  // puppeteer waits (waiting is not CPU). Applies to the Worker and its Durable Objects alike.
  "limits": { "cpu_ms": 60000 },
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "WhospostStore" },
      { "name": "SCAN_JOB", "class_name": "ScanJob" },
      // Renders link-preview cards (too much CPU for a Free-plan Worker request) and stores them per scan.
      { "name": "OG_IMAGE", "class_name": "OgImage" }
    ]
  },
  // Nightly backup of the data object to R2 (worker/backup.mjs): 04:00 Taipei = 20:00 UTC the day before.
  "triggers": { "crons": ["0 20 * * *"] },
  // Create once per account: npx wrangler r2 bucket create whospost-backups
  "r2_buckets": [
    { "binding": "BACKUPS", "bucket_name": "whospost-backups" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WhospostStore", "ScanJob"] },
    { "tag": "v2", "new_sqlite_classes": ["OgImage"] }
  ],
  // New-scan requests per IP: 5 per minute. The daily per-IP quota is enforced in the data object.
  // "我會去投票" pledges per IP: 3 per minute. The site-wide ceiling is WHOSPOST_PLEDGE_GLOBAL_PER_MIN in the data object.
  // Extension 即時查 (POST /api/scans from a whitelisted chrome-extension:// origin, no Turnstile): 5 new scans per
  // minute across ALL IPs under one fixed key (spent only when a scan actually starts; saved results and scans
  // already running are answered without it), so a script spoofing the Origin header and rotating addresses cannot
  // fill the shared WHOSPOST_GLOBAL_SCAN_RATE or burn the budget any faster than this. Without the binding the
  // channel is closed (503), never open.
  "ratelimits": [
    { "name": "SCAN_RATE_LIMITER", "namespace_id": "2701", "simple": { "limit": 5, "period": 60 } },
    { "name": "PLEDGE_RATE_LIMITER", "namespace_id": "2702", "simple": { "limit": 3, "period": 60 } },
    { "name": "EXT_SCAN_RATE_LIMITER", "namespace_id": "2703", "simple": { "limit": 5, "period": 60 } }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.otf"], "fallthrough": true }
  ],
  "vars": {
    "WHOSPOST_SCANS_ENABLED": "1",
    "WHOSPOST_COLLECTION_PROFILE": "standard-20",
    // Fetch provider: "apify" (paid actors), "browser" (Browser Rendering reads posts and replies from the
    // logged-out public pages, about US$0.001 per scan, but at most about ten replies) or "hybrid" (the browser
    // reads the posts, the Apify replies job runs beside it: about US$0.05 per scan with the full reply sample).
    // WHOSPOST_BROWSER_FALLBACK says what a failed browser fetch (launch, timeout, login wall, fewer than
    // WHOSPOST_BROWSER_MIN_POSTS posts) does: "apify" runs the Apify posts job instead (in "browser" mode the
    // replies job too), "fail" fails the scan. Switch here; a deploy with "apify" behaves exactly as before.
    "WHOSPOST_FETCH_PROVIDER": "hybrid",
    "WHOSPOST_BROWSER_FALLBACK": "apify",
    "WHOSPOST_BROWSER_MIN_POSTS": "1",
    "WHOSPOST_APIFY_LIMIT_USD": "100",
    "WHOSPOST_DAILY_LIMIT_USD": "5",
    "WHOSPOST_IP_DAILY_SCANS": "3",
    // Site-wide new-scan ceiling per minute, a backstop independent of the per-IP limit: even if cf-connecting-ip
    // is spoofed to evade the per-IP rate limit and daily quota, total new scans across all IPs stay capped. "0" disables.
    "WHOSPOST_GLOBAL_SCAN_RATE": "20",
    // Site-wide "我會去投票" pledges per minute, a backstop behind the per-IP PLEDGE_RATE_LIMITER. "0" disables.
    "WHOSPOST_PLEDGE_GLOBAL_PER_MIN": "300",
    "WHOSPOST_AI_ENABLED": "1",
    // Which model writes the AI 行為判斷: "gemini" (Gemini 3.8 Flash, secret GEMINI_API_KEY) or "claude" (Anthropic
    // Messages API, secret ANTHROPIC_API_KEY, model WHOSPOST_AI_CLAUDE_MODEL, default claude-haiku-5-5). Each
    // provider has its own cache key, so switching regenerates judgements once and the old ones stay stored. The
    // spend cap below is enforced with the price table of the selected provider (server/ai/claude.mjs for Claude).
    "WHOSPOST_AI_PROVIDER": "gemini",
    "WHOSPOST_AI_LIMIT_USD": "10",
    "WHOSPOST_CROSS_ACCOUNT_SEARCH": "0",
    // Comparing each scan with every earlier scan's rows from the same days read thousands of evidence rows per scan
    // (a large share of Durable Object rows_read) and matched nothing in an 80-scan sample, so it is off. "1" turns it on.
    "WHOSPOST_LOCAL_COMPARISON": "0",
    // Public hashed account list for the browser extension (/api/list/v1/*: export, buckets, appeals). "1" opens the
    // routes; off until the extension ships. WHOSPOST_EXTENSION_IDS (comma-separated Chrome extension IDs) narrows
    // CORS and appeals to those extensions; unset, any chrome-extension:// origin is accepted (development).
    // The same variable opens the extension's 即時查 channel (EXTENSION-SPEC §4.3): POST /api/scans from a listed
    // chrome-extension:// origin skips Turnstile (every other gate stays: per-IP rate limit, daily quota, budget caps)
    // and adds its own cross-IP ceiling, EXT_SCAN_RATE_LIMITER above (the Origin header is client-controlled).
    // For that channel an empty list means closed, so until the IDs are set here the extension cannot start scans.
    // Locally: wrangler dev --var WHOSPOST_EXTENSION_IDS:<id of the unpacked extension>.
    // WHOSPOST_PROFILE_LOOKUP (not set here: unset = "1", on) is the remote switch for the extension's 帳號背景
    // (EXTENSION-SPEC §4.4): "0" makes /api/health say extension.profileLookup=false and every installation stops
    // reading account background from Threads within the hour. To turn it off, add "WHOSPOST_PROFILE_LOOKUP": "0" here.
    "WHOSPOST_LIST_ENABLED": "1",
    // The extension's 封鎖助手 (EXTENSION-SPEC §4.5), reported to it as /api/health extension.block; "0" hides the button.
    "WHOSPOST_EXTENSION_BLOCK": "1"
    // Per-deployment Turnstile settings are secrets, not vars, so each fork sets its own and deploys never reset them:
    // TURNSTILE_SITE_KEY, TURNSTILE_SECRET and TURNSTILE_HOSTNAMES (frontend hostnames, e.g. whospost.<account>.workers.dev;
    // never localhost). Without them new scans stay closed. Local values go in .dev.vars.
  },
  // Workers Logs keeps every request (head_sampling_rate 1): one invocation log plus the structured lines from
  // worker/log.mjs (request, gate.denied, scan.*, apify.*, gemini.* or claude.* by WHOSPOST_AI_PROVIDER, do.error). Queries and alerts that rely on
  // them are in 100_Todo/specs/011-whospost/ops-alerts-20261021.md. Traces are sampled at 10%.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
