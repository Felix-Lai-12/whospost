{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whospost",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "WhospostStore" },
      { "name": "SCAN_JOB", "class_name": "ScanJob" },
      // Renders link-preview cards (too much CPU for a Free-plan Worker request) and stores them per scan.
      { "name": "OG_IMAGE", "class_name": "OgImage" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WhospostStore", "ScanJob"] },
    { "tag": "v2", "new_sqlite_classes": ["OgImage"] }
  ],
  // New-scan requests per IP: 5 per minute. The daily per-IP quota is enforced in the data object.
  "ratelimits": [{ "name": "SCAN_RATE_LIMITER", "namespace_id": "2701", "simple": { "limit": 5, "period": 60 } }],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.otf"], "fallthrough": true }
  ],
  "vars": {
    "WHOSPOST_SCANS_ENABLED": "1",
    "WHOSPOST_COLLECTION_PROFILE": "standard-25",
    "WHOSPOST_APIFY_LIMIT_USD": "5",
    "WHOSPOST_DAILY_LIMIT_USD": "1.5",
    "WHOSPOST_IP_DAILY_SCANS": "3",
    // Site-wide new-scan ceiling per minute, a backstop independent of the per-IP limit: even if cf-connecting-ip
    // is spoofed to evade the per-IP rate limit and daily quota, total new scans across all IPs stay capped. "0" disables.
    "WHOSPOST_GLOBAL_SCAN_RATE": "20",
    "WHOSPOST_AI_ENABLED": "1",
    "WHOSPOST_AI_LIMIT_USD": "1",
    "WHOSPOST_CROSS_ACCOUNT_SEARCH": "0"
    // Per-deployment Turnstile settings are secrets, not vars, so each fork sets its own and deploys never reset them:
    // TURNSTILE_SITE_KEY, TURNSTILE_SECRET and TURNSTILE_HOSTNAMES (frontend hostnames, e.g. whospost.<account>.workers.dev;
    // never localhost). Without them new scans stay closed. Local values go in .dev.vars.
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
