# Copy to .dev.vars for `npm run dev:worker`. Never commit .dev.vars.
# Production values are set with `npx wrangler secret put NAME`.
APIFY_TOKEN=
GEMINI_API_KEY=
# When WHOSPOST_AI_PROVIDER=claude or the Claude fallback is on (wrangler.jsonc WHOSPOST_AI_FALLBACK_PROVIDER).
ANTHROPIC_API_KEY=
# Cloudflare's published Turnstile test keys that always pass; use the real ones in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Test secret that always passes; use the real secret in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# The test secret reports hostname example.com and no action; allow it only locally.
TURNSTILE_HOSTNAMES=example.com,localhost,127.0.0.1
TURNSTILE_ALLOW_TEST_KEY=1
IP_HASH_SALT=local-dev-salt
# Optional: enables POST /api/admin/import for seeding saved results.
ADMIN_TOKEN=
# Not a secret, set with --var: the unpacked extension's ID opens its 即時查 channel on the local Worker, e.g.
#   npx wrangler dev --var WHOSPOST_EXTENSION_IDS:<32 letters> --var WHOSPOST_LIST_ENABLED:1
