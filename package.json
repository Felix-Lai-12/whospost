{
  "name": "whospost",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start": "node server/index.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/**/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "workers-og": "0.0.27"
  }
}
