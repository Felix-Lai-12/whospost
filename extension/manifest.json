{
 "manifest_version": 3,
 "name": "Whospost: 假帳號照妖鏡",
 "version": "0.1.0",
 "description": "在 Threads 貼文頁邊滑邊看，看到有嫌疑的，直接在頭貼旁按「AI 打詐」分析。只要是被 Whospost 查過的帳號，名字旁都會直接標記分析結果，任何用戶都可以直接看結果。",
 "minimum_chrome_version": "116",
 "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
 "permissions": ["storage"],
 "host_permissions": ["https://www.threads.com/*", "https://www.threads.net/*", "https://whospost.felixlai.workers.dev/*"],
 "background": {"service_worker": "background.js", "type": "module"},
 "content_scripts": [{
  "matches": ["https://www.threads.com/*", "https://www.threads.net/*"],
  "run_at": "document_idle",
  "js": ["content.js"],
  "css": ["content.css"]
 }],
 "web_accessible_resources": [{
  "resources": ["lib/*.mjs"],
  "matches": ["https://www.threads.com/*", "https://www.threads.net/*"]
 }],
 "action": {
  "default_popup": "popup.html",
  "default_title": "Whospost: 假帳號照妖鏡",
  "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}
 }
}
