{
 "manifest_version": 3,
 "name": "Whospost 留言線索",
 "version": "0.3.0",
 "description": "在 Threads 貼文頁已載入的回覆旁顯示 Whospost 的公開行為線索與本串觀察；不判定身分、不替你按任何按鈕。",
 "minimum_chrome_version": "116",
 "permissions": ["storage"],
 "host_permissions": ["https://www.threads.com/*", "https://www.threads.net/*", "https://whospost.felixlai.workers.dev/*"],
 "background": {"service_worker": "background.js", "type": "module"},
 "content_scripts": [{
  "matches": ["https://www.threads.com/*", "https://www.threads.net/*"],
  "run_at": "document_idle",
  "js": ["content.js"],
  "css": ["content.css"]
 }],
 "web_accessible_resources": [{
  "resources": ["lib/*.mjs"],
  "matches": ["https://www.threads.com/*", "https://www.threads.net/*"]
 }],
 "action": {"default_popup": "popup.html", "default_title": "Whospost 留言線索"}
}
